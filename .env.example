# Copy to .env and adjust. The application reads real environment variables;
# use a tool like `direnv` or `set -a; . ./.env; set +a` to load this file.

# HTTP
PORT=8088

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=financialanalyzer
DB_SSLMODE=disable

# cmd/import only — path to a <COMPANY>_<CATEGORY>.csv file
CSV_PATH=
