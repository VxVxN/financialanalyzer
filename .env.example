# Copy to .env and adjust. The application reads real environment variables;
# use a tool like `direnv` or `set -a; . ./.env; set +a` to load this file.

# HTTP
PORT=8088

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=financialanalyzer
DB_SSLMODE=disable

# cmd/plot — HTTP Basic Auth for the delete/note endpoints. Set both (or
# neither: then those endpoints are open and the server logs a warning).
AUTH_USER=
AUTH_PASSWORD=

# cmd/plot — built-in data refresh (off by default). Slots are Moscow time:
# "HH:MM" daily or "DAY HH:MM" weekly (mon..sun); "off" disables a job.
SCHEDULER_ENABLED=
SCHEDULE_QUOTES=07:00
SCHEDULE_FINANCIALS=sun 05:00

# cmd/import only — path to a <COMPANY>_<CATEGORY>.csv file
CSV_PATH=
