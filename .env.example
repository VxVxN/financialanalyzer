# Copy to .env and adjust. On startup the server reads .env from its working
# directory and does not override variables that are already set.

# HTTP
PORT=8088

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=financialanalyzer
DB_SSLMODE=disable

# cmd/plot — HTTP Basic Auth for write endpoints (delete, notes, manual
# figures, POST /api/fetch, POST /api/registry, POST /api/import). Set both (or neither:
# then those endpoints are open and the server logs a warning).
AUTH_USER=
AUTH_PASSWORD=

# cmd/plot — built-in data refresh (on by default). Slots are Moscow time:
# "HH:MM" daily or "DAY HH:MM" weekly (mon..sun); "off" disables a job.
# SCHEDULER_ENABLED=0 turns the timetable off.
SCHEDULER_ENABLED=1
SCHEDULE_QUOTES=07:00
SCHEDULE_FINANCIALS=sun 05:00

# cmd/plot scheduler and /updates fetches — report failed/partial data refreshes
# to a Telegram chat (create a bot with @BotFather; the chat id is numeric or
# "@channel"). Set both, or neither to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
